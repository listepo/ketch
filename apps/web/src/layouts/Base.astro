---
/** The one page shell: metadata, fonts, the header and the footer. */
import "../styles/global.css";
import { href } from "../url.ts";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const repo = "https://github.com/listepo/ketch";
const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://listepo.github.io");

// Described for search engines as what it is: a free package manager for
// macOS. The Hugo site carried the same claims, and losing them on the port
// would quietly cost the ranking the old site earned.
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "ketch",
  applicationCategory: "DeveloperApplication",
  operatingSystem: "macOS",
  description,
  url: canonical.href,
  codeRepository: repo,
  author: { "@type": "Person", name: "Ivan Tugay" },
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href={href("favicon.svg")} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="font-sans antialiased">
    <header class="border-b border-edge">
      <nav class="mx-auto flex max-w-5xl items-center gap-6 px-6 py-4">
        <a href={href()} class="font-mono text-lg font-semibold tracking-tight">ketch</a>
        <div class="ml-auto flex items-center gap-5 text-sm text-muted">
          <a class="hover:text-ink" href={href("docs/")}>Docs</a>
          <a class="hover:text-ink" href={href("docs/registry/")}>Registry</a>
          <a class="hover:text-ink" href={repo} rel="noopener">GitHub</a>
        </div>
      </nav>
    </header>

    <main class="mx-auto max-w-5xl px-6"><slot /></main>

    <footer class="mt-24 border-t border-edge">
      <div class="mx-auto flex max-w-5xl flex-wrap gap-x-6 gap-y-2 px-6 py-8 text-sm text-muted">
        <span>MIT licensed.</span>
        <a class="hover:text-ink" href={repo} rel="noopener">Source</a>
        <a class="hover:text-ink" href="https://github.com/listepo/ketch-registry" rel="noopener">
          Registry
        </a>
      </div>
    </footer>
  </body>
</html>

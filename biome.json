{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": false
  },
  "assist": {
    "enabled": true,
    "actions": { "source": { "organizeImports": "on" } }
  },
  "files": {
    "includes": ["**", "!**/dist", "!**/node_modules", "!**/*.schema.json", "!target", "!site"]
  }
}

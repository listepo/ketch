<Page
    x:Class="KetchApp.Pages.PackageDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:KetchApp"
    xmlns:core="using:Ketch.AppCore">
    <ScrollViewer>
        <StackPanel Padding="32,16,32,24" Spacing="12">
            <Button Click="OnBack" Content="Back" />
            <TextBlock x:Name="NameText" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock
                x:Name="DescriptionText"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    x:Name="UpgradeButton"
                    Click="OnUpgrade"
                    Style="{StaticResource AccentButtonStyle}" />
                <Button x:Name="UninstallButton" Click="OnUninstall" Content="Uninstall" />
            </StackPanel>

            <Pivot>
                <PivotItem Header="Overview">
                    <Grid Margin="0,12,0,0" ColumnSpacing="16" RowSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Version" />
                        <TextBlock x:Name="VersionText" Grid.Column="1" IsTextSelectionEnabled="True" />
                        <TextBlock
                            Grid.Row="1"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Source" />
                        <TextBlock
                            x:Name="SourceText"
                            Grid.Row="1"
                            Grid.Column="1"
                            IsTextSelectionEnabled="True" />
                        <TextBlock
                            Grid.Row="2"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Repository" />
                        <TextBlock
                            x:Name="RepoText"
                            Grid.Row="2"
                            Grid.Column="1"
                            IsTextSelectionEnabled="True" />
                        <TextBlock
                            Grid.Row="3"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Folder" />
                        <TextBlock
                            x:Name="PathText"
                            Grid.Row="3"
                            Grid.Column="1"
                            FontFamily="Cascadia Mono"
                            IsTextSelectionEnabled="True"
                            TextWrapping="Wrap" />
                    </Grid>
                </PivotItem>
                <PivotItem Header="Changelog">
                    <!-- Markdown as plain text for now: no Markdown control was
                         checked for WinUI 3 (docs/research-desktop-platforms.md). -->
                    <TextBlock
                        x:Name="ChangelogText"
                        Margin="0,12,0,0"
                        FontFamily="Cascadia Mono"
                        IsTextSelectionEnabled="True"
                        TextWrapping="Wrap" />
                </PivotItem>
            </Pivot>
        </StackPanel>
    </ScrollViewer>
</Page>

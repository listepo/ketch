<Window
    x:Class="KetchApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Mica behind a custom title bar: the window's own material, as Windows
         apps draw it; Acrylic is kept for flyouts. -->
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Title="Ketch"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="OnPaneToggleRequested" />

        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="True"
            PaneDisplayMode="Auto"
            ItemInvoked="OnNavigate">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Installed" Tag="installed">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE71D;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Discover" Tag="discover">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE721;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="UpdatesItem" Content="Updates" Tag="updates">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE895;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge x:Name="UpdatesBadge" Visibility="Collapsed" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem Content="Activity" Tag="activity">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="DoctorItem" Content="Doctor" Tag="doctor">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge x:Name="DoctorBadge" Visibility="Collapsed" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Busy, the running operation and errors sit above every
                     page, so none of them is lost when the page changes. -->
                <StackPanel Spacing="{StaticResource KetchSpaceXs}">
                    <InfoBar
                        x:Name="BusyBar"
                        Title="ketch is busy"
                        IsClosable="False"
                        Severity="Warning">
                        <InfoBar.ActionButton>
                            <Button Click="OnRetry" Content="Retry" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                    <InfoBar
                        x:Name="ActivityBar"
                        IsClosable="False"
                        Severity="Informational">
                        <StackPanel Margin="0,0,0,12" Spacing="{StaticResource KetchSpaceXs}">
                            <ProgressBar x:Name="ActivityProgress" Maximum="1" />
                            <TextBlock x:Name="ActivityStatus" Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                        <InfoBar.ActionButton>
                            <Button x:Name="CancelButton" Click="OnCancel" Content="Cancel" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                    <InfoBar
                        x:Name="ErrorBar"
                        Title="Something went wrong"
                        Closed="OnErrorClosed"
                        Severity="Error" />
                </StackPanel>

                <Frame x:Name="ContentFrame" Grid.Row="1" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>

  The Windows app: WinUI 3 on the Windows App SDK, built with the .NET SDK
  alone (`dotnet build -p:Platform=x64`), no Visual Studio. Unpackaged and
  self-contained, so the output folder runs by itself. The core is
  Ketch.AppCore's fake until the binding is wired (D12).
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>KetchApp</RootNamespace>
    <AssemblyName>Ketch</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <ProjectReference Include="../Ketch.AppCore/Ketch.AppCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Brand tokens, generated by desktop/design/build.mjs; the one copy. -->
    <Page Include="../../design/generated/KetchTokens.xaml" Link="KetchTokens.xaml" />
  </ItemGroup>
</Project>

{
  "$id": "https://raw.githubusercontent.com/listepo/ketch/main/packages/schemas/schemas/lockfile.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "package": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "tag": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "asset": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          },
          "pinned": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "source",
          "version",
          "tag",
          "target",
          "asset",
          "sha256"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version"
  ],
  "additionalProperties": false
}

{
  "$id": "https://raw.githubusercontent.com/listepo/ketch/main/packages/schemas/schemas/state.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "packages": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "tag": {
            "type": "string"
          },
          "target": {
            "type": "object",
            "properties": {
              "os": {
                "type": "string",
                "enum": [
                  "macos",
                  "linux",
                  "windows"
                ]
              },
              "arch": {
                "type": "string",
                "enum": [
                  "aarch64",
                  "x86_64",
                  "universal"
                ]
              }
            },
            "required": [
              "os",
              "arch"
            ]
          },
          "asset_name": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          },
          "checksum_verified": {
            "default": false,
            "type": "boolean"
          },
          "installed_at": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "prefix": {
            "type": "string"
          },
          "links": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "link": {
                  "type": "string"
                },
                "target": {
                  "type": "string"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "symlink",
                    "copied_app",
                    "linked_app"
                  ]
                }
              },
              "required": [
                "link",
                "target",
                "kind"
              ]
            }
          },
          "pinned": {
            "default": false,
            "type": "boolean"
          },
          "origin": {
            "anyOf": [
              {
                "type": "string",
                "const": "builtin"
              },
              {
                "type": "string",
                "const": "inferred"
              },
              {
                "type": "object",
                "properties": {
                  "registry": {
                    "type": "string"
                  }
                },
                "required": [
                  "registry"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "user": {
                    "type": "string"
                  }
                },
                "required": [
                  "user"
                ],
                "additionalProperties": false
              }
            ]
          },
          "manifest": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "$schema": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "source": {
                    "type": "string"
                  },
                  "description": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "homepage": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "kind": {
                    "default": "auto",
                    "type": "string",
                    "enum": [
                      "auto",
                      "binary",
                      "app"
                    ]
                  },
                  "asset": {
                    "default": {
                      "include": [],
                      "exclude": [],
                      "target": {}
                    },
                    "type": "object",
                    "properties": {
                      "include": {
                        "default": [],
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "exclude": {
                        "default": [],
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "target": {
                        "default": {},
                        "type": "object",
                        "propertyNames": {
                          "type": "string"
                        },
                        "additionalProperties": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "bin": {
                    "default": [],
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "path": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "name": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      }
                    }
                  },
                  "strip_prefix": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 8
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "prerelease": {
                    "default": false,
                    "type": "boolean"
                  },
                  "provides": {
                    "default": [],
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "notes": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "extra_paths": {
                    "default": [],
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "name",
                  "source"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "name",
          "version",
          "source",
          "tag",
          "target",
          "asset_name",
          "sha256",
          "installed_at",
          "prefix",
          "origin"
        ]
      }
    }
  },
  "required": [
    "version"
  ]
}

{
  "name": "ketch-monorepo",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=26",
    "bun": ">=1.3"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build",
    "lint": "oxlint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@moonrepo/cli": "^2.5.3",
    "@perryts/perry": "^0.5.1220",
    "@types/node": "^26.0.0",
    "oxlint": "^1.80.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
